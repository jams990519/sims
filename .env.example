# Copia este archivo como .env y rellénalo. NUNCA subas el .env a GitHub.

# Token que te dio @BotFather para @sims000bot (no se lo pases a nadie).
BOT_TOKEN=

# IDs de Telegram que entran sin invitación, separados por comas (tu ID aparece en ⚙️ Ajustes).
# Si lo dejas vacío, la primera persona que abra el bot (sin jugadores aún) entra como administradora.
ADMIN_IDS=

NOMBRE_JUEGO=SimPareja
DB_RUTA=datos/simpareja.db

# Minutos sin jugar hasta que el Sim se congela ❄️ (y deja de gastar necesidades).
PAUSA_MIN=5
# Minutos sin usar el bot hasta pasar de 🟢 en línea a ❄️ en pausa, y de ahí a ⚫ fuera de línea.
EN_LINEA_MIN=5
AUSENTE_MIN=60

# Personas por sala (2 = una pareja), días que dura una invitación y cuántas sin responder puede tener cada quien.
MAX_SALA=2
INVITACION_DIAS=7
MAX_INVITACIONES=5

# Eventos sorpresa (uno o dos por semana). EVENTOS=0 los apaga.
EVENTOS=1

# Botones abajo, en el teclado de Telegram (siempre visibles). BOTONES_ABAJO=0 los deja dentro de los mensajes.
BOTONES_ABAJO=1

# Hora real (con horario de verano) de quien no eligió su lugar: cuba, miami, mexico, colombia, venezuela,
# dominicana, argentina o espana.
ZONA_POR_DEFECTO=cuba

# ¿Se pueden crear personajes nuevos? 0 = cerrado (por defecto), 1 = abierto. Un admin lo cambia en ⚙️ Ajustes.
REGISTRO_ABIERTO=0

# Solo si el SERVIDOR está en un país donde Telegram está bloqueado (los jugadores no lo necesitan):
# TELEGRAM_PROXY=socks5://usuario:clave@host:1080
# TELEGRAM_API_URL=https://tu-servidor-bot-api.ejemplo.com
