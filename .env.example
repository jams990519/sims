# Copia este archivo como .env y rellénalo. NUNCA subas el .env a GitHub.

# Token que te dio @BotFather para @sims000bot (no se lo pases a nadie).
BOT_TOKEN=

# Tu ID de Telegram: escríbele /start al bot y te lo muestra. Varios separados por comas.
# Los administradores pueden entrar sin invitación (así entra la primera persona).
ADMIN_IDS=

NOMBRE_JUEGO=SimPareja
DB_RUTA=datos/simpareja.db

# Minutos sin usar el bot hasta pasar de 🟢 en línea a 🟡 ausente, y de ausente a ⚫ fuera de línea.
EN_LINEA_MIN=15
AUSENTE_MIN=60

# Personas por sala (2 = una pareja), días que dura una invitación y cuántas sin usar puede tener cada quien.
MAX_SALA=2
INVITACION_DIAS=7
MAX_INVITACIONES=5

# Solo si el SERVIDOR está en un país donde Telegram está bloqueado (los jugadores no lo necesitan):
# TELEGRAM_PROXY=socks5://usuario:clave@host:1080
# TELEGRAM_API_URL=https://tu-servidor-bot-api.ejemplo.com
